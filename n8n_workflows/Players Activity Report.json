    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const videoId = Date.now().toString(36).slice(-4) + Math.random().toString(36).substring(2, 6);\n\nconst binary = Object.values($input.item.binary)[0];\nconst originalName = binary.fileName || 'unknown.mp4';\n\nconst metadata = {\n    videoId: videoId,\n    uploadedAt: new Date().toISOString(),\n    internalName: `${videoId}.mp4`,\n    originalName: originalName, \n    videoPath: `/data/video/${videoId}.mp4`,\n    audioPath: `/data/audio/${videoId}.mp3`,\n    resultPath: `/data/result/${videoId}_result.json`,\n    status: 'processing'\n};\n\nreturn {\n    json: metadata,\n    binary: $input.item.binary\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        224
      ],
